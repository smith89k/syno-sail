CONTAINER_NAME=laravel-app
CONTAINER_REGISTRY_IMAGE=ghcr.io/smith89k/laravel-app:latest

APP_NAME=laravel
APP_ENV=production
APP_DEBUG=false
APP_PORT=8082
APP_KEY=
APP_TIMEZONE=Asia/Phnom_Penh
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=secret

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
QUEUE_WORKERS=1
