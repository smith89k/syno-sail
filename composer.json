{
    "name": "smith89k/syno-sail",
    "description": "Docker configuration package for Laravel projects on Synology with GUI managers.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "smith89k"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Smith89k\\SynoSail\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Smith89k\\SynoSail\\SynoSailServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
